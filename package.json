{
  "name": "nestro",
  "displayName": "Nestro",
  "description": "Manage npm/pnpm/yarn packages from the VS Code sidebar with update status and version switching",
  "version": "0.4.2",
  "publisher": "greentech-solutions",
  "icon": "resources/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GreenTech-Solutions/nestro.git"
  },
  "markdown": "standard",
  "keywords": [
    "npm",
    "pnpm",
    "yarn",
    "bun",
    "packages",
    "dependencies",
    "update",
    "manager",
    "sidebar",
    "audit"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Nestro reads local package files and runs package-manager processes."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Nestro requires local package files and package-manager processes."
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "activationEvents": [
    "workspaceContains:package.json"
  ],
  "main": "./out/extension.cjs",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nestro",
          "title": "Nestro",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "nestro": [
        {
          "id": "nestro.packagesView",
          "name": "Packages",
          "when": "workbenchState != empty",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "nestro.packagesView",
        "contents": "No Node.js project found in the workspace.\n[Open Folder](command:vscode.openFolder)",
        "when": "nestro.noWorkspace"
      }
    ],
    "configuration": {
      "title": "Nestro",
      "properties": {
        "nestro.checkUpdatesOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "After the initial package scan completes, run one update check on each extension activation."
        },
        "nestro.includePreReleases": {
          "type": "boolean",
          "default": false,
          "description": "Include alpha, beta, and release-candidate versions in update checks and in the Pick Version version list. Disabled by default because prereleases can be less stable; enable it only when that risk is acceptable."
        },
        "nestro.minimumReleaseAgeDays": {
          "type": "number",
          "default": 7,
          "minimum": 0,
          "maximum": 99000000,
          "description": "Minimum age in days before Nestro accepts a release for an update check; the value must be a whole number of days, or the default is used. For Nestro checks, this value overrides native package-manager release-age settings; newer releases may be deferred to an older eligible version, missing publish times are reported as unknown, and applying an update inside the window prompts for confirmation. The default 7-day cooldown reduces newly published release risk but delays updates; set to 0 to disable this Nestro policy. It does not change package-manager install behavior."
        },
        "nestro.updateTarget": {
          "type": "string",
          "enum": [
            "latest",
            "greatest",
            "minor",
            "patch"
          ],
          "default": "latest",
          "enumDescriptions": [
            "Use the package's latest dist-tag version, accepting a new major version when it is published under that tag, subject to the prerelease and minimum release age settings.",
            "Choose the highest available version, independent of dist-tags, subject to the prerelease and minimum release age settings.",
            "Allow patch and minor upgrades while staying on the current major version, subject to the prerelease and minimum release age settings.",
            "Allow only patch upgrades within the current major and minor version, subject to the prerelease and minimum release age settings."
          ],
          "description": "Select the version target used by update checks. The chosen target controls how far a dependency may move; prerelease inclusion and the release-age cooldown still apply."
        },
        "nestro.defaultFilter": {
          "type": "string",
          "enum": [
            "all",
            "hasUpdates",
            "patch",
            "minor",
            "breaking"
          ],
          "default": "all",
          "enumDescriptions": [
            "Show every discovered dependency, including packages without updates.",
            "Show packages with an available update of any update type.",
            "Show only packages with patch updates.",
            "Show only packages with minor updates.",
            "Show only packages whose update raises the major version."
          ],
          "description": "Choose the package rows shown by the sidebar when Nestro starts. The Update All command acts only on the rows currently visible; the filter does not change which updates are checked. Every filter except All also hides a package while its update is in progress."
        },
        "nestro.deferInstallAfterUpdate": {
          "type": "boolean",
          "default": false,
          "description": "Write selected update versions to package.json without running the package manager. Run Nestro: Run Install separately to update installed packages and lockfiles; when disabled, each update runs the package manager immediately."
        },
        "nestro.confirmBulkUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Show confirmation dialog before updating all visible packages."
        },
        "nestro.runAuditOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "After the initial package scan completes, run one detected-package-manager security audit for each resolved project on every extension activation. This is independent of update checks and is disabled by default."
        },
        "nestro.monorepoGlob": {
          "type": "string",
          "default": "**/package.json",
          "description": "Glob used to discover package.json files in the workspace."
        },
        "nestro.checkUpdatesDebounce": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "description": "Minimum seconds between update checks when the package files and update policy are unchanged. A click inside this window is ignored; after it, a valid cached result is reused without a network fetch. Set to 0 to disable this debounce. checkUpdatesForceAlways overrides this setting."
        },
        "nestro.checkUpdatesForceAlways": {
          "type": "boolean",
          "default": false,
          "description": "When no update check is already running, start every Check for Updates click immediately, bypassing checkUpdatesDebounce and the update cache. This can make a network request on every click; changes to update policy or package files already invalidate the cache and bypass the debounce."
        }
      }
    },
    "commands": [
      {
        "command": "nestro.refresh",
        "title": "Refresh",
        "category": "Nestro",
        "icon": "$(refresh)"
      },
      {
        "command": "nestro.checkUpdates",
        "title": "Check for Updates",
        "category": "Nestro",
        "icon": "$(cloud-download)"
      },
      {
        "command": "nestro.runAudit",
        "title": "Run Security Audit",
        "category": "Nestro",
        "icon": "$(shield)",
        "enablement": "nestro.canRunAudit"
      },
      {
        "command": "nestro.openAuditReport",
        "title": "Open Security Audit Report",
        "category": "Nestro",
        "icon": "$(report)"
      },
      {
        "command": "nestro.installUpdate",
        "title": "Update Package",
        "icon": "$(arrow-up)"
      },
      {
        "command": "nestro.pickVersion",
        "title": "Pick Version...",
        "icon": "$(list-unordered)"
      },
      {
        "command": "nestro.switchDepType",
        "title": "Switch to dev/dep",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "nestro.pinVersion",
        "title": "Toggle version pin",
        "icon": "$(lock)"
      },
      {
        "command": "nestro.removePackage",
        "title": "Remove Package",
        "icon": "$(trash)"
      },
      {
        "command": "nestro.updateAllVisible",
        "title": "Update All",
        "category": "Nestro",
        "icon": "$(cloud-upload)",
        "enablement": "nestro.canUpdateVisiblePackages"
      },
      {
        "command": "nestro.runInstall",
        "title": "Run Install",
        "category": "Nestro",
        "icon": "$(terminal)",
        "enablement": "nestro.canRunInstall"
      },
      {
        "command": "nestro.openOnNpm",
        "title": "Open on npmjs.com",
        "icon": "$(link-external)"
      },
      {
        "command": "nestro.copyPackageName",
        "title": "Copy Package Name",
        "icon": "$(copy)"
      },
      {
        "command": "nestro.setFilter",
        "title": "Set Filter"
      },
      {
        "command": "nestro.showFilterPicker",
        "title": "Select Filter"
      },
      {
        "command": "nestro.searchPackages",
        "title": "Search Packages",
        "category": "Nestro",
        "icon": "$(search)",
        "enablement": "nestro.canSearchPackages"
      },
      {
        "command": "nestro.clearSearchQuery",
        "title": "Clear Search Query",
        "icon": "$(clear-all)"
      },
      {
        "command": "nestro.openSettings",
        "title": "Settings",
        "category": "Nestro",
        "icon": "$(settings-gear)"
      },
      {
        "command": "nestro.pinAllVersions",
        "title": "Pin All Versions",
        "category": "Nestro",
        "icon": "$(lock)",
        "enablement": "nestro.canPinAllVersions"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "nestro.setFilter",
          "when": "false"
        },
        {
          "command": "nestro.showFilterPicker",
          "when": "false"
        },
        {
          "command": "nestro.installUpdate",
          "when": "false"
        },
        {
          "command": "nestro.pickVersion",
          "when": "false"
        },
        {
          "command": "nestro.switchDepType",
          "when": "false"
        },
        {
          "command": "nestro.pinVersion",
          "when": "false"
        },
        {
          "command": "nestro.removePackage",
          "when": "false"
        },
        {
          "command": "nestro.openOnNpm",
          "when": "false"
        },
        {
          "command": "nestro.copyPackageName",
          "when": "false"
        },
        {
          "command": "nestro.clearSearchQuery",
          "when": "false"
        },
        {
          "command": "nestro.updateAllVisible",
          "when": "nestro.canUpdateVisiblePackages"
        },
        {
          "command": "nestro.runInstall",
          "when": "nestro.canRunInstall"
        },
        {
          "command": "nestro.searchPackages",
          "when": "nestro.canSearchPackages"
        },
        {
          "command": "nestro.runAudit",
          "when": "nestro.canRunAudit"
        },
        {
          "command": "nestro.pinAllVersions",
          "when": "nestro.canPinAllVersions"
        }
      ],
      "view/title": [
        {
          "command": "nestro.refresh",
          "when": "view == nestro.packagesView",
          "group": "navigation"
        },
        {
          "command": "nestro.checkUpdates",
          "when": "view == nestro.packagesView",
          "group": "navigation"
        },
        {
          "command": "nestro.updateAllVisible",
          "when": "view == nestro.packagesView && nestro.canUpdateVisiblePackages",
          "group": "navigation"
        },
        {
          "command": "nestro.runInstall",
          "when": "view == nestro.packagesView && nestro.canRunInstall",
          "group": "navigation"
        },
        {
          "command": "nestro.openSettings",
          "when": "view == nestro.packagesView",
          "group": "navigation@99"
        },
        {
          "command": "nestro.searchPackages",
          "when": "view == nestro.packagesView && nestro.canSearchPackages",
          "group": "2_advanced@1"
        },
        {
          "command": "nestro.runAudit",
          "when": "view == nestro.packagesView && nestro.canRunAudit",
          "group": "2_advanced@2"
        },
        {
          "command": "nestro.pinAllVersions",
          "when": "view == nestro.packagesView && nestro.canPinAllVersions",
          "group": "2_advanced@3"
        }
      ],
      "view/item/context": [
        {
          "command": "nestro.installUpdate",
          "when": "view == nestro.packagesView && viewItem =~ /(^|-)outdated($|-)/",
          "group": "inline"
        },
        {
          "command": "nestro.pickVersion",
          "when": "view == nestro.packagesView && viewItem =~ /^(package|outdated)/",
          "group": "inline@2"
        },
        {
          "command": "nestro.openOnNpm",
          "when": "view == nestro.packagesView && viewItem =~ /^(package|outdated|installing)/",
          "group": "inline@3"
        },
        {
          "command": "nestro.switchDepType",
          "when": "view == nestro.packagesView && viewItem =~ /^(package|outdated)/",
          "group": "inline@4"
        },
        {
          "command": "nestro.pinVersion",
          "when": "view == nestro.packagesView && viewItem =~ /(^|-)pinnable($|-)/",
          "group": "inline@5"
        },
        {
          "command": "nestro.removePackage",
          "when": "view == nestro.packagesView && viewItem =~ /^(package|outdated)/",
          "group": "inline@6"
        },
        {
          "command": "nestro.copyPackageName",
          "when": "view == nestro.packagesView && viewItem =~ /^(package|outdated|installing)/",
          "group": "navigation@2"
        },
        {
          "command": "nestro.clearSearchQuery",
          "when": "view == nestro.packagesView && viewItem == search-active",
          "group": "inline"
        },
        {
          "command": "nestro.switchDepType",
          "when": "view == nestro.packagesView && viewItem =~ /^(package|outdated)/",
          "group": "2_manage@1"
        },
        {
          "command": "nestro.pinVersion",
          "when": "view == nestro.packagesView && viewItem =~ /(^|-)pinnable($|-)/",
          "group": "2_manage@2"
        },
        {
          "command": "nestro.removePackage",
          "when": "view == nestro.packagesView && viewItem =~ /^(package|outdated)/",
          "group": "2_manage@3"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "vscode:prepublish": "pnpm run build",
    "test:compile": "tsc -p tsconfig.test.json",
    "pretest": "pnpm run test:compile && pnpm run lint",
    "check:vsce": "pnpm run test:compile && node out/tools/verifyVsixCli.js",
    "audit:dependencies": "pnpm audit --audit-level high",
    "audit:signatures": "pnpm run test:compile && node out/tools/auditSignaturesCli.js",
    "ci:evidence": "pnpm run test:compile && node out/tools/ciEvidenceCli.js",
    "ci:policy": "pnpm run test:compile && node out/tools/ciPolicyCli.js",
    "release:prepare": "pnpm run test:compile && node out/tools/releasePrepareCli.js",
    "release:candidate": "pnpm run test:compile && node out/tools/releaseCandidateCli.js",
    "typecheck": "tsc --noEmit",
    "lint:eslint": "eslint src --max-warnings=0",
    "lint": "pnpm run lint:eslint",
    "lint:fix": "eslint --fix src",
    "test": "vscode-test",
    "pretest:minimum": "pnpm run pretest",
    "test:minimum": "vscode-test --label minimum",
    "pretest:stable": "pnpm run pretest",
    "test:stable": "vscode-test --label stable",
    "test:packaged": "pnpm run test:compile && node out/test/packagedSmokeCli.js",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest"
  },
  "devDependencies": {
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/mocha": "10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "1.125.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "10.8.0",
    "eslint-config-flat-gitignore": "2.3.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "semantic-release": "25.0.8",
    "semantic-release-vsce": "6.1.6",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  },
  "type": "commonjs",
  "packageManager": "pnpm@11.20.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@vscode/vsce-sign",
      "keytar"
    ]
  },
  "dependencies": {
    "npm-check-updates": "23.0.0"
  },
  "vsce": {
    "dependencies": false
  }
}
