{
  "name": "nestro",
  "displayName": "Nestro",
  "description": "%extension.description%",
  "version": "1.0.1",
  "publisher": "greentech-solutions",
  "icon": "resources/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GreenTech-Solutions/nestro.git"
  },
  "homepage": "https://github.com/GreenTech-Solutions/nestro",
  "bugs": {
    "url": "https://github.com/GreenTech-Solutions/nestro/issues"
  },
  "markdown": "standard",
  "keywords": [
    "npm",
    "pnpm",
    "yarn",
    "bun",
    "packages",
    "dependencies",
    "update",
    "manager",
    "sidebar",
    "audit"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces.description%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces.description%"
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:package.json"
  ],
  "main": "./out/extension.cjs",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nestro",
          "title": "Nestro",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "nestro": [
        {
          "id": "nestro.packagesView",
          "name": "%views.packages.name%",
          "when": "workbenchState != empty",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "nestro.packagesView",
        "contents": "%viewsWelcome.noWorkspace.contents%",
        "when": "nestro.noWorkspace"
      }
    ],
    "configuration": {
      "title": "Nestro",
      "properties": {
        "nestro.checkUpdatesOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.checkUpdatesOnStartup.description%"
        },
        "nestro.includePreReleases": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.includePreReleases.description%"
        },
        "nestro.minimumReleaseAgeDays": {
          "type": "number",
          "default": 7,
          "minimum": 0,
          "maximum": 99000000,
          "description": "%configuration.minimumReleaseAgeDays.description%"
        },
        "nestro.updateTarget": {
          "type": "string",
          "enum": [
            "latest",
            "greatest",
            "minor",
            "patch"
          ],
          "default": "latest",
          "enumDescriptions": [
            "%configuration.updateTarget.enum.latest%",
            "%configuration.updateTarget.enum.greatest%",
            "%configuration.updateTarget.enum.minor%",
            "%configuration.updateTarget.enum.patch%"
          ],
          "description": "%configuration.updateTarget.description%"
        },
        "nestro.defaultFilter": {
          "type": "string",
          "enum": [
            "all",
            "hasUpdates",
            "patch",
            "minor",
            "breaking"
          ],
          "default": "all",
          "enumDescriptions": [
            "%configuration.defaultFilter.enum.all%",
            "%configuration.defaultFilter.enum.hasUpdates%",
            "%configuration.defaultFilter.enum.patch%",
            "%configuration.defaultFilter.enum.minor%",
            "%configuration.defaultFilter.enum.breaking%"
          ],
          "description": "%configuration.defaultFilter.description%"
        },
        "nestro.deferInstallAfterUpdate": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.deferInstallAfterUpdate.description%"
        },
        "nestro.confirmBulkUpdate": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.confirmBulkUpdate.description%"
        },
        "nestro.runAuditOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.runAuditOnStartup.description%"
        },
        "nestro.monorepoGlob": {
          "type": "string",
          "default": "**/package.json",
          "description": "%configuration.monorepoGlob.description%"
        },
        "nestro.checkUpdatesDebounce": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "description": "%configuration.checkUpdatesDebounce.description%"
        },
        "nestro.checkUpdatesForceAlways": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.checkUpdatesForceAlways.description%"
        }
      }
    },
    "commands": [
      {
        "command": "nestro.refresh",
        "title": "%commands.nestro.refresh.title%",
        "category": "Nestro",
        "icon": "$(refresh)"
      },
      {
        "command": "nestro.checkUpdates",
        "title": "%commands.nestro.checkUpdates.title%",
        "category": "Nestro",
        "icon": "$(cloud-download)"
      },
      {
        "command": "nestro.runAudit",
        "title": "%commands.nestro.runAudit.title%",
        "category": "Nestro",
        "icon": "$(shield)",
        "enablement": "nestro.canRunAudit"
      },
      {
        "command": "nestro.openAuditReport",
        "title": "%commands.nestro.openAuditReport.title%",
        "category": "Nestro",
        "icon": "$(report)"
      },
      {
        "command": "nestro.openStatusReport",
        "title": "%commands.nestro.openStatusReport.title%",
        "category": "Nestro",
        "icon": "$(output)"
      },
      {
        "command": "nestro.installUpdate",
        "title": "%commands.nestro.installUpdate.title%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "nestro.pickVersion",
        "title": "%commands.nestro.pickVersion.title%",
        "icon": "$(list-unordered)"
      },
      {
        "command": "nestro.switchDepType",
        "title": "%commands.nestro.switchDepType.title%",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "nestro.pinVersion",
        "title": "%commands.nestro.pinVersion.title%",
        "icon": "$(lock)"
      },
      {
        "command": "nestro.removePackage",
        "title": "%commands.nestro.removePackage.title%",
        "icon": "$(trash)"
      },
      {
        "command": "nestro.updateAllVisible",
        "title": "%commands.nestro.updateAllVisible.title%",
        "category": "Nestro",
        "icon": "$(cloud-upload)",
        "enablement": "nestro.canUpdateVisiblePackages"
      },
      {
        "command": "nestro.runInstall",
        "title": "%commands.nestro.runInstall.title%",
        "category": "Nestro",
        "icon": "$(terminal)",
        "enablement": "nestro.canRunInstall"
      },
      {
        "command": "nestro.openOnNpm",
        "title": "%commands.nestro.openOnNpm.title%",
        "icon": "$(link-external)"
      },
      {
        "command": "nestro.copyPackageName",
        "title": "%commands.nestro.copyPackageName.title%",
        "icon": "$(copy)"
      },
      {
        "command": "nestro.setFilter",
        "title": "%commands.nestro.setFilter.title%"
      },
      {
        "command": "nestro.showFilterPicker",
        "title": "%commands.nestro.showFilterPicker.title%"
      },
      {
        "command": "nestro.searchPackages",
        "title": "%commands.nestro.searchPackages.title%",
        "category": "Nestro",
        "icon": "$(search)"
      },
      {
        "command": "nestro.clearSearchQuery",
        "title": "%commands.nestro.clearSearchQuery.title%",
        "icon": "$(clear-all)"
      },
      {
        "command": "nestro.openSettings",
        "title": "%commands.nestro.openSettings.title%",
        "category": "Nestro",
        "icon": "$(settings-gear)"
      },
      {
        "command": "nestro.pinAllVersions",
        "title": "%commands.nestro.pinAllVersions.title%",
        "category": "Nestro",
        "icon": "$(lock)",
        "enablement": "nestro.canPinAllVersions"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "nestro.setFilter",
          "when": "false"
        },
        {
          "command": "nestro.showFilterPicker",
          "when": "false"
        },
        {
          "command": "nestro.installUpdate",
          "when": "false"
        },
        {
          "command": "nestro.pickVersion",
          "when": "false"
        },
        {
          "command": "nestro.switchDepType",
          "when": "false"
        },
        {
          "command": "nestro.pinVersion",
          "when": "false"
        },
        {
          "command": "nestro.removePackage",
          "when": "false"
        },
        {
          "command": "nestro.openOnNpm",
          "when": "false"
        },
        {
          "command": "nestro.copyPackageName",
          "when": "false"
        },
        {
          "command": "nestro.clearSearchQuery",
          "when": "false"
        },
        {
          "command": "nestro.updateAllVisible",
          "when": "nestro.canUpdateVisiblePackages"
        },
        {
          "command": "nestro.runInstall",
          "when": "nestro.canRunInstall"
        },
        {
          "command": "nestro.searchPackages",
          "when": "nestro.canSearchPackages"
        },
        {
          "command": "nestro.runAudit",
          "when": "nestro.canRunAudit"
        },
        {
          "command": "nestro.pinAllVersions",
          "when": "nestro.canPinAllVersions"
        }
      ],
      "view/title": [
        {
          "command": "nestro.refresh",
          "when": "view == nestro.packagesView",
          "group": "navigation@1"
        },
        {
          "command": "nestro.checkUpdates",
          "when": "view == nestro.packagesView",
          "group": "navigation@2"
        },
        {
          "command": "nestro.updateAllVisible",
          "when": "view == nestro.packagesView && nestro.canUpdateVisiblePackages",
          "group": "navigation@3"
        },
        {
          "command": "nestro.searchPackages",
          "when": "view == nestro.packagesView && nestro.canSearchPackages",
          "group": "1_find@1"
        },
        {
          "command": "nestro.showFilterPicker",
          "when": "view == nestro.packagesView && nestro.canFilterPackages",
          "group": "1_find@2"
        },
        {
          "command": "nestro.clearSearchQuery",
          "when": "view == nestro.packagesView && nestro.hasSearchQuery",
          "group": "1_find@3"
        },
        {
          "command": "nestro.runInstall",
          "when": "view == nestro.packagesView && nestro.canRunInstall",
          "group": "2_operations@1"
        },
        {
          "command": "nestro.runAudit",
          "when": "view == nestro.packagesView && nestro.canRunAudit",
          "group": "2_operations@2"
        },
        {
          "command": "nestro.pinAllVersions",
          "when": "view == nestro.packagesView && nestro.canPinAllVersions",
          "group": "2_operations@3"
        },
        {
          "command": "nestro.openSettings",
          "when": "view == nestro.packagesView",
          "group": "9_settings@1"
        }
      ],
      "view/item/context": [
        {
          "command": "nestro.installUpdate",
          "when": "view == nestro.packagesView && viewItem =~ /(^|-)outdated($|-)/",
          "group": "inline"
        },
        {
          "command": "nestro.pickVersion",
          "when": "view == nestro.packagesView && viewItem =~ /^(package|outdated)/",
          "group": "inline@2"
        },
        {
          "command": "nestro.openOnNpm",
          "when": "view == nestro.packagesView && viewItem =~ /^(package|outdated|installing)/",
          "group": "navigation@1"
        },
        {
          "command": "nestro.copyPackageName",
          "when": "view == nestro.packagesView && viewItem =~ /^(package|outdated|installing)/",
          "group": "navigation@2"
        },
        {
          "command": "nestro.switchDepType",
          "when": "view == nestro.packagesView && viewItem =~ /^(package|outdated)/",
          "group": "2_manage@1"
        },
        {
          "command": "nestro.pinVersion",
          "when": "view == nestro.packagesView && viewItem =~ /(^|-)pinnable($|-)/",
          "group": "2_manage@2"
        },
        {
          "command": "nestro.removePackage",
          "when": "view == nestro.packagesView && viewItem =~ /^(package|outdated)/",
          "group": "3_danger@1"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "vscode:prepublish": "pnpm run build",
    "test:compile": "tsc -p tsconfig.test.json",
    "pretest": "pnpm run test:compile && pnpm run lint",
    "check:vsce": "pnpm run test:compile && node out/tools/verifyVsixCli.js",
    "audit:dependencies": "pnpm audit --audit-level high",
    "audit:signatures": "pnpm run test:compile && node out/tools/auditSignaturesCli.js",
    "ci:evidence": "pnpm run test:compile && node out/tools/ciEvidenceCli.js",
    "release:provenance": "pnpm run test:compile && node out/tools/artifactProvenanceCli.js",
    "ci:policy": "pnpm run test:compile && node out/tools/ciPolicyCli.js",
    "release:prepare": "pnpm run test:compile && node out/tools/releasePrepareCli.js",
    "release:candidate": "pnpm run test:compile && node out/tools/releaseCandidateCli.js",
    "typecheck": "tsc --noEmit",
    "lint:eslint": "eslint src --max-warnings=0",
    "lint": "pnpm run lint:eslint",
    "lint:fix": "eslint --fix src",
    "test": "vscode-test",
    "pretest:minimum": "pnpm run pretest",
    "test:minimum": "vscode-test --label minimum",
    "pretest:stable": "pnpm run pretest",
    "test:stable": "vscode-test --label stable",
    "test:packaged": "pnpm run test:compile && node out/test/packagedSmokeCli.js",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "screenshots": "node scripts/screenshots/capture.mjs"
  },
  "devDependencies": {
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/mocha": "10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "1.125.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "10.8.0",
    "eslint-config-flat-gitignore": "2.3.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "semantic-release": "25.0.8",
    "semantic-release-vsce": "6.1.6",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  },
  "type": "commonjs",
  "packageManager": "pnpm@11.20.0",
  "dependencies": {
    "npm-check-updates": "23.0.0"
  },
  "vsce": {
    "dependencies": false
  }
}
